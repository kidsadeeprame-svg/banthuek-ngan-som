{
  // ตั้งค่าให้ Cloudflare เผยแพร่ไฟล์ในโฟลเดอร์ app/ เป็นเว็บไซต์
  // ไม่มีโค้ดฝั่งเซิร์ฟเวอร์เลย — เสิร์ฟไฟล์นิ่ง ๆ อย่างเดียว
  // โฟลเดอร์อื่น (setup, backup, docs, prototype) จะไม่ถูกเผยแพร่
  "name": "banthuek-app",
  "compatibility_date": "2026-08-01",
  // ต้องมีบรรทัดนี้ ไม่งั้นจะได้ "No URLs enabled" คือ deploy สำเร็จแต่ไม่มี URL ให้เข้า
  "workers_dev": true,
  "assets": {
    "directory": "./app"
  }
}
